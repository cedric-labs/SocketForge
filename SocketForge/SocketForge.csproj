<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\ProcessForge\ProcessForge\ProcessForge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SocketForge.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>SocketForge</PackageId>
    <Version>1.0.2</Version>
    <Authors>curvecoder</Authors>
    <Company>curvecoder</Company>
    <Description>Cross-platform active socket scanner for Win32 and Linux.</Description>
    <RepositoryUrl>https://github.com/curvecoder/SocketForge</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\FRAMEWORK.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

</Project>
